# Erudi backend -- environment variables
#
# Copy to `backend/.env` (git-ignored) or export in your shell. Every variable
# is optional: the backend runs with no `.env` at all. This file is a template
# and must never carry a value -- `tests/test_env_example.py` enforces both
# that rule and that every variable the backend reads is listed here.

# ---- Secrets ---------------------------------------------------------------

# Hugging Face access token, only needed to download gated models. Read from the
# environment at runtime; never embedded in a build. Format: hf_...
HF_TOKEN=

# ---- Runtime (read by the backend on every start) --------------------------

# Force CPU_Engine even when a GPU is detected (any non-empty value).
ERUDI_FORCE_CPU=

# Log level for backend/logs/backend.log: DEBUG, INFO (default), WARNING, ERROR.
ERUDI_LOG_LEVEL=

# Set to 1 ONLY to debug the agent layer against LangSmith. The launcher
# otherwise forces LANGSMITH_TRACING and LANGCHAIN_TRACING_V2 to "false",
# because `langsmith` ships inside the build and either variable is enough to
# send every system prompt, knowledge-base excerpt, question and answer to
# api.smith.langchain.com. Turning this on means your conversations leave the
# machine. Never set it in a build you distribute.
ERUDI_ALLOW_LANGSMITH_TRACING=

# ---------------------------------------------------------------------------
# Written by the launcher, not read from you.
#
# run.py ASSIGNS these four on every start, overwriting whatever the process
# inherited. They are listed here because the app touches them, not because you
# are meant to set them -- setting them has no effect. Each one is a switch that
# would otherwise send data off the machine, and the backend inherits the whole
# user environment plus anything load_dotenv() finds walking up from the working
# directory, so a value can arrive without anyone intending it.
#
# HF_HUB_DISABLE_TELEMETRY -> forced to "1"
# HF_HUB_DISABLE_XET       -> forced to "1" (downloads use the regular file CDN,
#                             never the Xet storage service; the packaged app
#                             does not ship hf_xet)
# LANGSMITH_TRACING        -> forced to "false" (unless ERUDI_ALLOW_LANGSMITH_TRACING=1)
# LANGCHAIN_TRACING_V2     -> forced to "false" (the legacy name, kept because old
#                             shell profiles outlive library renames)
# ---------------------------------------------------------------------------
HF_HUB_DISABLE_TELEMETRY=
HF_HUB_DISABLE_XET=
LANGSMITH_TRACING=
LANGCHAIN_TRACING_V2=

# Root directory for data, logs and the embedded Postgres cluster (default:
# backend/data in dev, a per-user app-data directory in packaged builds).
ERUDI_DATA_ROOT=

# Knowledge-base retrieval mode override: 1 forces agentic, 0 forces systematic,
# unset lets the model's tool-calling support decide.
ERUDI_KB_AGENTIC=

# Pins the llama-server context window in tokens for the CPU/CUDA engines
# (passed verbatim as -c, which llama-server honours unchanged). Unset: no -c
# is passed and the engine resolves the window itself at load -- the model's
# trained window, automatically reduced against the machine's free memory when
# it must (llama.cpp --fit). MLX never reads this: its window is the model's
# trained window, bounded at spawn (--max-kv-size preflight validator).
ERUDI_CTX=

# Simulated free VRAM in GB for the CUDA engine offload heuristic (dev/test only).
ERUDI_VRAM_OVERRIDE_GB=

# CUDA toolkit root; set by the NVIDIA installer, read to locate the runtime DLLs.
CUDA_PATH=

# Set to 1 by the Electron main process: the launcher exits on stdin EOF.
ERUDI_WATCH_STDIN=

# Set to 1 to disable the parent-process watchdog for deliberately detached runs.
ERUDI_NO_PARENT_WATCHDOG=

# OS-provided data directories used to place the app-data root in packaged
# builds (Windows: LOCALAPPDATA; Linux: XDG_DATA_HOME / XDG_STATE_HOME).
LOCALAPPDATA=
XDG_DATA_HOME=
XDG_STATE_HOME=

# ---- Dev only (scripts, migrations, opt-in tests) --------------------------

# Port used by scripts/dev/dev-start.sh and the Electron dev launcher (default
# 27182). The backend itself takes `--port` on the command line.
BACKEND_PORT=

# Database URL for the Alembic CLI (`alembic upgrade head`); the app sets it
# programmatically at boot.
ERUDI_ALEMBIC_URL=

# Opt-in test suites: 1 enables tests that hit the live Hugging Face API,
# the <think> token regression, and the Gemma <end_of_turn> EOS regression.
ERUDI_TEST_NETWORK=
ERUDI_TEST_THINKING=
ERUDI_TEST_GEMMA=
