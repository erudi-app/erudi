{
  "_comment": "Where a packaged backend keeps its data and its logs, per platform, and the name of the file that marks a folder as Erudi's. Read by backend/tests/test_runtime_paths.py (against src/launcher/runtime_paths.py) and by frontend/src/utils/dataLocations.test.js (against the Electron side, which opens and clears these folders): the two implementations cannot drift apart without one of them failing. Every path is relative to the home folder; so is an env value, except an empty one (the variable is set but empty) and one starting with ~ (passed as is).",
  "ownership_sentinel": ".erudi-owned",
  "cases": [
    {
      "name": "macOS",
      "system": "Darwin",
      "platform": "darwin",
      "env": {},
      "data_dir": "Library/Application Support/erudi/backend/prod/data",
      "log_dir": "Library/Logs/erudi"
    },
    {
      "name": "Windows without LOCALAPPDATA",
      "system": "Windows",
      "platform": "win32",
      "env": {},
      "data_dir": "AppData/Local/erudi/backend/prod/data",
      "log_dir": "AppData/Local/erudi/logs"
    },
    {
      "name": "Windows with LOCALAPPDATA",
      "system": "Windows",
      "platform": "win32",
      "env": { "LOCALAPPDATA": "local-app-data" },
      "data_dir": "local-app-data/erudi/backend/prod/data",
      "log_dir": "local-app-data/erudi/logs"
    },
    {
      "name": "Windows with an empty LOCALAPPDATA",
      "system": "Windows",
      "platform": "win32",
      "env": { "LOCALAPPDATA": "" },
      "data_dir": "AppData/Local/erudi/backend/prod/data",
      "log_dir": "AppData/Local/erudi/logs"
    },
    {
      "name": "Linux without XDG variables",
      "system": "Linux",
      "platform": "linux",
      "env": {},
      "data_dir": ".local/share/erudi/backend/prod/data",
      "log_dir": ".local/state/erudi/logs"
    },
    {
      "name": "Linux with XDG variables",
      "system": "Linux",
      "platform": "linux",
      "env": { "XDG_DATA_HOME": "xdg-data", "XDG_STATE_HOME": "xdg-state" },
      "data_dir": "xdg-data/erudi/backend/prod/data",
      "log_dir": "xdg-state/erudi/logs"
    },
    {
      "name": "Linux with empty XDG variables",
      "system": "Linux",
      "platform": "linux",
      "env": { "XDG_DATA_HOME": "", "XDG_STATE_HOME": "" },
      "data_dir": ".local/share/erudi/backend/prod/data",
      "log_dir": ".local/state/erudi/logs"
    },
    {
      "name": "ERUDI_DATA_ROOT on macOS",
      "system": "Darwin",
      "platform": "darwin",
      "env": { "ERUDI_DATA_ROOT": "instance" },
      "data_dir": "instance/data",
      "log_dir": "instance/logs"
    },
    {
      "name": "ERUDI_DATA_ROOT on Windows",
      "system": "Windows",
      "platform": "win32",
      "env": { "ERUDI_DATA_ROOT": "instance" },
      "data_dir": "instance/data",
      "log_dir": "instance/logs"
    },
    {
      "name": "ERUDI_DATA_ROOT on Linux",
      "system": "Linux",
      "platform": "linux",
      "env": { "ERUDI_DATA_ROOT": "instance" },
      "data_dir": "instance/data",
      "log_dir": "instance/logs"
    },
    {
      "name": "ERUDI_DATA_ROOT under ~ on macOS",
      "system": "Darwin",
      "platform": "darwin",
      "env": { "ERUDI_DATA_ROOT": "~/instance" },
      "data_dir": "instance/data",
      "log_dir": "instance/logs"
    },
    {
      "name": "ERUDI_DATA_ROOT under ~ on Linux",
      "system": "Linux",
      "platform": "linux",
      "env": { "ERUDI_DATA_ROOT": "~/instance" },
      "data_dir": "instance/data",
      "log_dir": "instance/logs"
    }
  ]
}
